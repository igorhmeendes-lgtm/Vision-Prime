# ===== Mercado Livre (developers.mercadolivre.com.br > Minhas aplicações) =====
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser IDÊNTICA à cadastrada no app do ML (HTTPS obrigatório em produção)
ML_REDIRECT_URI=https://seu-dominio.com/auth/callback
# 1 = roda com dados simulados, sem credenciais (para testar o sistema)
ML_MOCK=0

# ===== Servidor =====
PORT=3000
# Senha do painel (usuário: admin). Deixe vazio só em uso local.
DASHBOARD_PASSWORD=

# ===== Pesquisa de produtos =====
# Categorias monitoradas (IDs MLB). Veja em /api/categories no painel.
RESEARCH_CATEGORIES=MLB1648,MLB1000,MLB1574,MLB1246,MLB1276
# Intervalo da pesquisa automática (horas)
RESEARCH_INTERVAL_HOURS=6

# ===== Custos e regras de margem (vendendo como CPF) =====
# Imposto sobre o preço de venda (0 para CPF; 0.04 a 0.06 se migrar para Simples/MEI)
TAX_RATE=0
# Reserva para devoluções/cancelamentos (% do preço)
RETURN_RESERVE_RATE=0.03
# Taxa do hub/fornecedor por pedido (R$)
SUPPLIER_FEE_PER_ORDER=0
# Custo de embalagem por pedido, se o fornecedor cobrar (R$)
PACKAGING_COST=0
# Margem líquida mínima para considerar viável (0.15 = 15%)
TARGET_MARGIN=0.15
# Tipo de anúncio: gold_special (Clássico) ou gold_pro (Premium)
LISTING_TYPE=gold_special

# ===== Sincronização de estoque com o fornecedor =====
# 0 = só simula e registra (recomendado no início); 1 = aplica no ML
AUTO_SYNC_STOCK=0
# Unidades que ficam de reserva no fornecedor (proteção contra venda sem estoque)
STOCK_SAFETY_BUFFER=2
# Teto de unidades anunciadas por SKU
STOCK_MAX_PUBLISHED=50
STOCK_SYNC_INTERVAL_MINUTES=30
