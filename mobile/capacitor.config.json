{
  "appId": "com.loteclip.app",
  "appName": "LoteClip",
  "webDir": "www",
  "backgroundColor": "#0B1120",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0B1120",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B1120"
    }
  }
}
